<Window x:Class="Axion.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador — Axion TradeStation by VM Trader" 
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B0E14"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, sans-serif">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Axion TradeStation" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Desenvolvido por VM Trader • Solução Autônoma de Alta Performance" 
                               FontSize="12" Foreground="#EAB308" FontStyle="Italic" Margin="0,3,0,0"/>
                </StackPanel>

                <Image Grid.Column="1" Source="pack://application:,,,/logo_vm_trader.png" 
                       Height="48" Width="Auto" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="28,20">
            <!-- Step 1: Configuration & Info -->
            <StackPanel x:Name="ConfigPanel" Visibility="Visible">
                <TextBlock x:Name="TxtWelcomeTitle" Text="Bem-vindo ao Instalador do Axion TradeStation" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtWelcomeDesc" Text="Este assistente instalará a estação de trabalho completa em seu computador, configurando os arquivos essenciais e atalhos operacionais." 
                           TextWrapping="Wrap" FontSize="13" Foreground="#94A3B8" LineHeight="18" Margin="0,0,0,16"/>

                <TextBlock Text="Pasta de Instalação no Computador:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallPath" 
                             Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" 
                             Padding="10,8" FontSize="12" VerticalContentAlignment="Center" IsReadOnly="False"/>
                    <Button Grid.Column="1" x:Name="BtnBrowse" Content="Procurar..." 
                            Background="#334155" BorderThickness="0" Padding="14,0" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                </Grid>

                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Opções Adicionais de Inicialização:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="Criar atalho na Área de Trabalho (Desktop)" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkStartMenuShortcut" Content="Criar atalho no Menu Iniciar do Windows" IsChecked="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2: Progress -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtProgressStatus" Text="Instalando arquivos do Axion TradeStation..." FontSize="15" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBarInst" Height="14" Minimum="0" Maximum="100" Value="0" 
                             Background="#1E293B" Foreground="#0284C7" BorderThickness="0" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtProgressDetail" Text="Extraindo binários autônomos .NET 8 e interface gráfica..." 
                           FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Step 3: Finished -->
            <StackPanel x:Name="FinishedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="✅ Instalação Concluída com Sucesso!" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" Margin="0,0,0,8"/>
                <TextBlock Text="O Axion TradeStation foi instalado com êxito e está pronto para uso operacional." 
                           FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="ChkRunAtFinish" Content="🚀 Iniciar o Axion TradeStation agora ao concluir" IsChecked="True" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Desenvolvido por VM Trader • Todos os direitos reservados." 
                           FontSize="11" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Footer Actions -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock Text="VM Trader Software Solutions" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancelar" 
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                            Padding="18,8" Margin="0,0,10,0" Click="BtnCancel_Click"/>

                    <Button x:Name="BtnAction" Content="Instalar Agora" 
                            Background="#0284C7" BorderThickness="0" 
                            Padding="22,8" Click="BtnAction_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
