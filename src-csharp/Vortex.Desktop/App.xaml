<Application x:Class="Vortex.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Vortex Professional Cyberpunk Dark Theme -->
        <Color x:Key="BgDark">#0A0E1A</Color>
        <Color x:Key="SidebarDark">#0F172A</Color>
        <Color x:Key="CardDark">#131B2E</Color>
        <Color x:Key="CardHeader">#1E293B</Color>
        <Color x:Key="BorderDark">#1E293B</Color>
        <Color x:Key="AccentCyan">#06B6D4</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentGreen">#10B981</Color>
        <Color x:Key="AccentRed">#EF4444</Color>
        <Color x:Key="AccentYellow">#F59E0B</Color>
        <Color x:Key="AccentPurple">#A855F7</Color>
        <Color x:Key="TextLight">#F8FAFC</Color>
        <Color x:Key="TextMuted">#94A3B8</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarDark}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardDark}"/>
        <SolidColorBrush x:Key="CardHeaderBrush" Color="{StaticResource CardHeader}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderDark}"/>
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource AccentCyan}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

        <!-- Custom Clean Scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
        </Style>
    </Application.Resources>
</Application>
